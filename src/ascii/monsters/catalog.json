{
  "schema_version": 1,
  "note": "Content catalog for design/tooling. Domain evolution rules are not implemented by this file.",
  "families": {
    "fuzz": {
      "name": "Fuzz Family",
      "concept": "毛量と丸みが増えていく、BitPetの王道もふもふ系。",
      "legacy": "Fluffy",
      "tree": "Mofflet -> Fuzzard -> Brumruff / Woolram",
      "final_hint": "Care寄りでBrumruff、Activity寄りでWoolram。"
    },
    "wing": {
      "name": "Wing Family",
      "concept": "翼や大きな横幅へ成長する、外出・探索に似合う飛行系。",
      "legacy": "Sharp",
      "tree": "Flitter -> Fuzzwing -> Grandwing / Mantara",
      "final_hint": "Adventure寄りでGrandwing、Balanced寄りでMantara。"
    },
    "drift": {
      "name": "Drift Family",
      "concept": "身体が軽くなり、雲や浮遊生物のようになる漂遊系。",
      "legacy": "Weird",
      "tree": "Bloblet -> Floatle -> Cloudruff / Driftle",
      "final_hint": "Gentle/Rest寄りでCloudruff、Adventure寄りでDriftle。"
    },
    "spike": {
      "name": "Spike Family",
      "concept": "角・突起・嘴など輪郭が鋭く発達していく系統。",
      "legacy": "Sharp",
      "tree": "Spindle -> Pricklet -> Starwing / Beakruff",
      "final_hint": "Brave寄りでStarwing、Care寄りでBeakruff。"
    },
    "colony": {
      "name": "Colony Family",
      "concept": "分裂・双子化・多頭化によって個体数が増えていく系統。",
      "legacy": "Weird",
      "tree": "Buddle -> Twindle -> Tribble / Cerbloop",
      "final_hint": "Play/Social寄りでTribble、Battle/Brave寄りでCerbloop。"
    },
    "flora": {
      "name": "Flora Family",
      "concept": "芽・根・植物のようなパーツが育つ穏やかな系統。",
      "legacy": "Fluffy",
      "tree": "Spriglet -> Dewbud -> Bloomuff / Rainroot",
      "final_hint": "Care寄りでBloomuff、Rest/Low-activity寄りでRainroot。"
    },
    "oddling": {
      "name": "Oddling Family",
      "concept": "既存の生物分類に収まりにくい、BitPetらしい謎生物系。",
      "legacy": "Weird",
      "tree": "Wormlet -> Whiskerp -> Crownruff / Manelet",
      "final_hint": "特殊条件・同点・低頻度条件などの受け皿にする。"
    }
  },
